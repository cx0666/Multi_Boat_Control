<?xml version="1.0"?>
<launch>
    <!-- 
    Phase 2 Integration Test Launch File - 端到端集成测试
    
    完整的四节点系统，验证"感知->决策->执行"闭环链路：
    1. rtk_node: RTK GPS数据采集
    2. state_estimator_node: RTK+航向角状态融合
    3. control_interface_node: Pixhawk控制接口
    4. end_to_end_tester: 航向角闭环控制器
    
    测试流程:
    1. 启动此launch文件
    2. 等待所有节点初始化完成
    3. 在end_to_end_tester终端输入目标航向角
    4. 观察无人艇自动转向至目标方向
    
    零外部依赖，完全自包含
    -->
    
    <!-- 系统参数配置 -->
    <arg name="rtk_device" default="/dev/ttyUSB1" />
    <arg name="rtk_baud" default="115200" />
    <arg name="pixhawk_device" default="/dev/ttyUSB0" />
    <arg name="pixhawk_baud" default="921600" />
    
    <!-- Phase 1: RTK GPS数据采集 -->
    <node name="rtk_node" pkg="multi_boat_control" type="rtk_node.py" output="screen">
        <param name="port" value="$(arg rtk_device)" />
        <param name="baudrate" value="$(arg rtk_baud)" />
        <param name="timeout" value="1.0" />
    </node>
    
    <!-- Phase 1: 状态估计（重构版，融合RTK+航向角） -->
    <node name="state_estimator_node" pkg="multi_boat_control" type="state_estimator_node.py" output="screen">
        <param name="publish_rate" value="10.0" />
        <param name="max_data_age" value="2.0" />
        <param name="require_both_sources" value="true" />
        <param name="min_gps_accuracy" value="5.0" />
        <param name="heading_timeout" value="3.0" />
        
        <!-- 话题映射 -->
        <remap from="rtk_data" to="rtk_data" />
        <remap from="boat/heading" to="boat/heading" />
        <remap from="boat_state" to="boat_state" />
    </node>
    
    <!-- Phase 2: 增强控制接口（Pixhawk通信+IMU+航向角发布） -->
    <node name="control_interface_node" pkg="multi_boat_control" type="control_interface_node.py" 
          output="screen" required="true">
        
        <!-- Pixhawk连接参数 -->
        <param name="connect_string" value="$(arg pixhawk_device)" />
        <param name="baud_rate" value="$(arg pixhawk_baud)" />
        <param name="connection_timeout" value="60" />
        <param name="max_init_retries" value="3" />
        <param name="publish_rate" value="10.0" />
        
        <!-- 安全参数（测试环境优化） -->
        <param name="max_forward_speed" value="2.0" />
        <param name="min_forward_speed" value="-0.5" />
        <param name="max_yaw_rate" value="1.0" />
        <param name="min_yaw_rate" value="-1.0" />
        
        <!-- 话题映射 -->
        <remap from="~cmd_vel" to="control_interface_node/cmd_vel" />
        <remap from="boat/imu/data" to="imu/data" />
        <remap from="boat/heading" to="boat/heading" />
    </node>
    
    <!-- Phase 2 优化: 端到端测试节点（航向角闭环控制） -->
    <node name="end_to_end_tester" pkg="multi_boat_control" type="end_to_end_tester.py" 
          output="screen">
        <!-- 话题订阅和发布映射 -->
        <remap from="/boat_state" to="boat_state" />
        <remap from="/control_interface_node/cmd_vel" to="control_interface_node/cmd_vel" />
    </node>
    
    <!-- 系统状态监控（可选，用于调试） -->
    <group if="false">
        <node name="boat_state_echo" pkg="rostopic" type="rostopic" 
              args="echo /boat_state" output="screen" />
    </group>
    
</launch>